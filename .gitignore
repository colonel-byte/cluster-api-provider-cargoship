.DS_Store
.direnv/
.idea/
.scratch/
/.tool-versions
*.tar
*.tar.gz
*.tgz
*.zst
!**/testdata/**
coverage.out
cover.out

# Added for goreleaser:
/dist/

# The manager binaries `make build` writes.
/bin/

# The component manifests `make release-manifests` writes. They are a release artifact, built
# from the kustomizations, so the checked-in source of truth is bootstrap/config and
# controlplane/config rather than anything here.
/out/

# Added for mdbook:
/book/

# commitlint is an npm package, installed by the workflow that lints pull request titles.
.github/commitlint/node_modules/

# Added for go mod vendor. The tree is committed: this follows colonel-byte/cargoship, whose
# management node is air-gapped, so a build has to work with no module proxy reachable.
!/vendor/
